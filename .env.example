# Machine-specific environment variables for Claude Code config
# Copy this file to .env and fill in values for your machine

# Path to Chromium-based browser executable for Playwright MCP server
# macOS examples:
#   /Applications/Brave Browser.app/Contents/MacOS/Brave Browser
#   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux examples:
#   /usr/bin/brave-browser
#   /usr/bin/chromium-browser
#   /usr/bin/google-chrome
BROWSER_PATH="/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"

# --- Local oMLX server (optional; the `qwen` harness) ----------------------
# Qwen Code's own `qwen auth` subcommand is removed in 0.21.10, but the CLI
# still honours the OpenAI-compatible env triad — so these three point the
# `qwen` harness at a local OpenAI-compatible server (oMLX, llama-server, …)
# instead of any cloud provider. Leave unset to use whatever the CLI resolves.
#   OPENAI_MODEL must be the id the server actually serves; list them with
#   `curl -H "Authorization: Bearer $OPENAI_API_KEY" $OPENAI_BASE_URL/models`
OPENAI_API_KEY="sk-local-placeholder"
OPENAI_BASE_URL="http://127.0.0.1:8000/v1"
OPENAI_MODEL="Qwen3.8-27B-oQ4e-mtp"
