<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent that keeps a fleet worker (`sdlc queue run` as worker m3max,
  Story 35.2-001) resident on the M3 Max — Story 35.2-004. Same shape as
  com.fxmartin.sdlc-queue.plist (Story 35.1-003).

  Substitute the two __PLACEHOLDERS__ below; launchd expands neither `~` nor
  `$VARS`, so every path is absolute:

    __HOME__  the account's home, e.g. /Users/fxmartin
    __USER__  the account's login, for nix-darwin's per-user profile on PATH

  Install:

    mkdir -p ~/.local/state/sdlc
    sed -e "s|__HOME__|$HOME|g" -e "s|__USER__|$USER|g" \
        templates/launchd/com.fxmartin.sdlc-worker.plist \
        > ~/Library/LaunchAgents/com.fxmartin.sdlc-worker.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.fxmartin.sdlc-worker.plist

  SDLC_QUEUE_PATH and XDG_STATE_HOME are pinned because launchd starts the
  worker with a bare environment: unpinned, it would drain ~/.sdlc/queue.db and
  record its runs in ~/.sdlc/registry.json, where a shell exporting
  XDG_STATE_HOME=$HOME/.local/state (and its `sdlc doctor` and dashboard) never
  looks. Its jobs inherit both.

  Export the same value in your shell profile (macOS sets no XDG_STATE_HOME),
  so `sdlc queue add` and every enqueue write the queue this worker drains and
  the dashboard reads the registry its runs land in:

    export XDG_STATE_HOME="$HOME/.local/state"

  `sdlc doctor` reads the worker's store from this plist and warns while the
  shell's differs.

  Which queue it drains: this Mac's own (the SDLC_QUEUE_PATH above) unless a
  fleet queue is named — SDLC_QUEUE_URL (add it to EnvironmentVariables with
  SDLC_QUEUE_TOKEN if this Mac has no Tailscale CLI for the identity gate) or a
  `queue_url:` in ~/.sdlc-fleet.yaml, which the agent reads as you. Then
  this worker drains the fleet queue on home-lab over HTTP
  (Story 35.2-005): it registers, heartbeats, claims, renews and finishes there,
  so a job enqueued on the XPS runs on this Mac. A fleet drain must be a named
  worker (this plist's ProgramArguments name m3max); a lost network keeps its
  jobs running, and KeepAlive restarts it only if it exits.

  Each job runs under `caffeinate -i` (macOS only): the Mac may idle-sleep
  between jobs, and a closed lid still sleeps it unless it runs in clamshell
  mode on power with an external display.
-->
<plist version="1.0">
<dict>
  <!-- Keep this label: `sdlc doctor` finds the agent by its file name, and its
       remedy addresses the agent by it. -->
  <key>Label</key>
  <string>com.fxmartin.sdlc-worker</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/sdlc</string>
    <string>queue</string>
    <string>run</string>
    <string>--worker</string>
    <string>m3max</string>
    <string>--pool</string>
    <string>claude-m3</string>
    <string>--pool</string>
    <string>codex-shared</string>
    <string>--follow</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/etc/profiles/per-user/__USER__/bin:/run/current-system/sw/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>SDLC_QUEUE_PATH</key>
    <string>__HOME__/.local/state/sdlc/queue.db</string>
    <key>XDG_STATE_HOME</key>
    <string>__HOME__/.local/state</string>
  </dict>

  <!-- Start when loaded (at login), and restart on any exit — including exit
       75, which the worker takes once the controller is reinstalled under it,
       so the restart runs the new code. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- launchd stops the worker with SIGTERM (`launchctl bootout`, which every
       reinstall of this plist runs, or `kickstart -k`) and sends SIGKILL after
       ExitTimeOut. The worker takes SIGTERM like Ctrl-C: it stops its running
       jobs one after another (SIGTERM, then SIGKILL after 10 s) and releases
       each lease. With two in flight that can take 40 s; launchd's default
       (system-defined, typically 20 s) would cut it short and leave the
       second job running unwatched. -->
  <key>ExitTimeOut</key>
  <integer>60</integer>

  <!-- One log for both streams, so the worker's progress (stdout) and its
       errors (stderr) read in order. -->
  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/sdlc/worker.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/sdlc/worker.log</string>

  <!-- Interactive, not Background: every job is this agent's child and
       inherits its resource class. Background means low CPU priority and
       throttled disk I/O (efficiency cores only on Apple Silicon), and even
       the unset default throttles CPU and I/O; either stretches a 30-90 min
       build towards its queue wall-clock budget. The lightweight queue service
       (35.1-003) rightly stays Background. -->
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
